# Copy this to .env and fill in your values
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_PIN=change-this-admin-pin
GOOGLE_VISION_KEY=your-google-vision-key-optional
NODE_ENV=production
PORT=3000

# Boss PINs for auto-seeded businesses (each shop is created on startup only
# when its PIN is set here; min 4 chars). Leave blank to not create that shop.
LSC_BOSS_PIN=
REDLINE_BOSS_PIN=
ANGELS_BOSS_PIN=
